ADDR=":3000"
APP_URL="http://localhost:3000"
DATABASE_URL="postgres://mails:mails@localhost:5437/mails?sslmode=disable"
# Encrypts stored integration secrets. Generate: openssl rand -base64 32
SECRET=""

# GitHub OAuth app. Callback URL: <APP_URL>/api/auth/callback/github
# The first GitHub account to sign in owns this instance; all others are refused.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Delivery reporting. Leave both empty and use Settings -> Reporting (or
# `mails ses-setup-events`); set them only to manage reporting by hand.
SES_CONFIGURATION_SET=""
SES_SNS_TOPIC_ARN=""
SES_MAIL_FROM_PREFIX="mail"
SES_DKIM_SELECTOR="mail"

# Shared with the Cloudflare worker. Generate: openssl rand -hex 32
INBOUND_WEBHOOK_SECRET=""
# Let the worker read SPF/DKIM/DMARC from Cloudflare's header. Read
# worker/PAYLOAD.md first; redeploy the worker after changing it.
WORKER_TRUST_AUTH_RESULTS="false"

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="mail-attachments"

# Web Push. Generate a pair with: mails vapid-keys
# Without them the Notifications page says so and offers nothing.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Set false to run the send queue in another process.
OUTBOX_WORKER="true"
RUN_MIGRATIONS_ON_BOOT="true"
