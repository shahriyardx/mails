{
  "name": "mails-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Mails in the browser toolbar: new-mail notifications, inbox and reading, for Chrome, Firefox and Edge.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Md Shahriyar Alam <mdshahriyaralam552@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:all": "wxt build && wxt build -b firefox && wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "wxt zip && wxt zip -b firefox && wxt zip -b edge",
    "prepare": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "dompurify": "^3.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "culori": "^4.0.2",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^5.1.1",
    "wxt": "^0.21.0"
  }
}
